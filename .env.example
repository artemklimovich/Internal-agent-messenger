# MAG Master CRM — source of truth for tasks, KB, CRM, Social Content
# App: https://app.magaicrm.ru   Docs: https://magaicrm.ru/help/docs/mcp/external-agents
MAG_MASTER_API_URL=https://app.magaicrm.ru/api
# Optional env fallback. Prefer cabinet «Подключить MAG Master» (X-Agent-Key).
MAGMASTER_API_KEY=
MAGMASTER_PROJECT_ID=mag-hive

# MAG Hive hub
HIVE_HUB_URL=http://127.0.0.1:43147
HIVE_PUBLIC_URL=http://127.0.0.1:43147
# Required in production. Without it a secret is written to .data/session-secret
HIVE_SESSION_SECRET=

# OpenClaw / MAG Bot node — issue in Hive cabinet, shown once, never put in MAG KB
HIVE_AGENT_KEY=

# Reverse SSH from agent machine (no static IP) → hub sshd
# hive-join.sh: HIVE_SSH_HOST + HIVE_REVERSE_PORT from the Tunnels tab
HIVE_SSH_HOST=
HIVE_SSH_USER=claw
HIVE_WAKE_PORT=18790
HIVE_REVERSE_PORT=

# Closed overlay: own swarm HTTP only on 10.42.0.1 (`npm run start:overlay`)
# UDP 51820 must remain reachable from the internet so NAT clients can join WG.
# HIVE_BIND=10.42.0.1
HIVE_WG_ENDPOINT=
HIVE_OVERLAY_IP=
HIVE_WG_CONF=
